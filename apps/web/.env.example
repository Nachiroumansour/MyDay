# Base de données
DATABASE_URL="postgresql://myday:myday@localhost:5435/myday"

# Origine absolue du site. WhatsApp et Facebook ne résolvent pas une URL
# d'image relative : sans elle, aucun aperçu de partage ne s'affiche.
NEXT_PUBLIC_ORIGINE="http://localhost:3000"

# Paiement simulé, le temps que les accès marchands soient obtenus.
# À NE JAMAIS activer en production avec de vrais clients.
PAIEMENT_SIMULE=1

