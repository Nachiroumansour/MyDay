    <!-- Le bouquet d'angle, dessiné pour le coin haut-gauche puis retourné
         aux trois autres. Feuillage d'abord, roses par-dessus, or en dernier.
         Il court le long des deux bords plutôt qu'en diagonale : c'est ainsi
         que les faire-part se composent, le décor encadre le texte. -->
    <g id="bouquet">
      <g stroke="#1B3F2C" stroke-width=".5">
        <use href="#feuille-longue" fill="#24563A" transform="translate(4 74) rotate(74) scale(1.05)"/>
        <use href="#feuille-longue" fill="#2F6B45" transform="translate(10 26) rotate(34) scale(1.15)"/>
        <use href="#feuille-forme"  fill="#3E7F52" transform="translate(46 6) rotate(-8) scale(1.1)"/>
        <use href="#feuille-longue" fill="#1E4B33" transform="translate(96 12) rotate(4) scale(1.2)"/>
        <use href="#feuille-forme"  fill="#4C8A5C" transform="translate(150 26) rotate(-22) scale(.95)"/>
        <use href="#feuille-fine"   fill="#5B9463" transform="translate(178 8) rotate(-34) scale(.9)"/>
        <use href="#feuille-forme"  fill="#2F6B45" transform="translate(22 132) rotate(84) scale(1)"/>
        <use href="#feuille-fine"   fill="#3E7F52" transform="translate(-2 108) rotate(58) scale(.95)"/>
        <use href="#feuille-longue" fill="#24563A" transform="translate(72 104) rotate(48) scale(.85)"/>
        <use href="#feuille-forme"  fill="#1E4B33" transform="translate(126 76) rotate(24) scale(.8)"/>
        <use href="#feuille-fine"   fill="#4C8A5C" transform="translate(-8 46) rotate(-48) scale(.85)"/>
        <use href="#feuille-forme"  fill="#5B9463" transform="translate(46 158) rotate(66) scale(.75)"/>
      </g>

      <use href="#brin-or" transform="translate(38 62) rotate(-18) scale(1.1)"/>
      <use href="#brin-or" transform="translate(20 106) rotate(30) scale(.9)"/>
      <use href="#brin-or" transform="translate(110 40) rotate(-6) scale(.85)"/>

      <use href="#rose" transform="translate(56 60) scale(1.35)"/>
      <use href="#rose" transform="translate(118 32) scale(.95) rotate(24)"/>
      <use href="#rose" transform="translate(28 118) scale(.85) rotate(-18)"/>
      <use href="#rose" transform="translate(96 96) scale(.62) rotate(40)"/>
      <use href="#bouton" transform="translate(158 52) rotate(34) scale(1)"/>
      <use href="#bouton" transform="translate(6 84) rotate(-40) scale(.85)"/>
      <use href="#bouton" transform="translate(64 148) rotate(62) scale(.8)"/>
    </g>
